<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <!-- Core -->
        <PackageVersion Include="Antlr4.Runtime.Standard" Version="4.13.1" />
        <PackageVersion Include="Antlr4BuildTasks" Version="12.14.0" />
        <PackageVersion Include="CSharpScriptSerializer" Version="4.0.0" />
        <PackageVersion Include="StyleCop.Analyzers" Version="1.1.118" />

        <!-- ASP.NET Core / Extensions -->
        <PackageVersion Include="Microsoft.ApplicationInsights.AspNetCore" Version="3.1.1" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.8" />
        <PackageVersion Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.8" />
        <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.8" />
        <PackageVersion Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.8" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.8" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.8" />
        <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.8" />
        <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.8" />
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.8" />
        <PackageVersion Include="OpenTelemetry.Api" Version="1.15.3" />

        <!-- Roslyn / Build -->
        <PackageVersion Include="Microsoft.Build" Version="18.6.3" />
        <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.3.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.3.0" />

        <!-- Diagnostic client -->
        <PackageVersion Include="ModelContextProtocol" Version="1.3.0" />

        <!-- Testing -->
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
        <PackageVersion Include="xunit.v3" Version="3.2.2" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />

        <!-- Benchmarking -->
        <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    </ItemGroup>
</Project>
