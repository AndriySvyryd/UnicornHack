<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UnicornHack.DiagnosticClient</RootNamespace>
    <AssemblyName>UnicornHack.DiagnosticClient</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.7" />
    <PackageReference Include="ModelContextProtocol" Version="0.3.0-preview.4" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Reuses the server's *Change DTOs and GeneratedResolver directly. The hand-written
      formatters under UnicornHack.Web/Hubs/MessagePack only invoke a property setter
      when its ChangedProperties bit is set, so the setter side effect that re-sets the
      same bit is always a no-op.
    -->
    <ProjectReference Include="..\..\src\UnicornHack.Web\UnicornHack.Web.csproj" />
  </ItemGroup>

</Project>
